{
  "name": "react-parallax-mousemove",
  "version": "2.0.1",
  "description": "Mousemove parallax layers for React with spring physics, zero dependencies, and TypeScript types",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react,react-dom --target es2019",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamcwade/react-parallax-mousemove.git"
  },
  "author": "Adam Wade <adamwade2384@gmail.com>",
  "bugs": {
    "url": "https://github.com/adamcwade/react-parallax-mousemove/issues"
  },
  "homepage": "https://github.com/adamcwade/react-parallax-mousemove#readme",
  "license": "MIT",
  "keywords": [
    "react",
    "parallax",
    "mousemove",
    "mouse",
    "spring",
    "animation",
    "layer"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
